    "build": "node scripts/frontend.mjs build",
    "preview": "node scripts/frontend.mjs preview",
    "build:mobile": "node scripts/frontend.mjs build mobile",
    "build:app": "npm run build:mobile && npx cap copy",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:mobile-assets": "node scripts/verify-mobile-assets.mjs",
    "test": "node tooling/node_modules/vitest/vitest.mjs run",
    "test:browser": "node tooling/node_modules/@playwright/test/cli.js test",
    "test:login:5178": "node tooling/node_modules/@playwright/test/cli.js test --config login-validation.playwright.config.mjs",
    "test:guandan:feedback": "node tooling/node_modules/@playwright/test/cli.js test --config guandan-feedback.playwright.config.mjs",
    "test:isolated": "node scripts/isolated-supabase-check.mjs",
