    "local:reset": "node scripts/local-compose.mjs reset",
    "local:verify": "node scripts/local-db.mjs verify",
    "local:migrate": "node scripts/local-db.mjs migrate",
    "android:check": "node scripts/android-toolchain.mjs",
    "android:prepare": "npm run build:mobile && npx cap sync android",
    "android:debug": "node scripts/android-debug-check.mjs",
    "mobile:prepare:test": "node scripts/prepare-mobile-test.mjs",
    "ios:check": "node scripts/ios-readiness.mjs",
    "verify:apk-assets": "node scripts/verify-apk-assets.mjs",
    "dev:isolated": "node scripts/frontend.mjs dev isolated",
    "test:online:browser": "node tooling/node_modules/@playwright/test/cli.js test --config phase3b.playwright.config.mjs",
    "local:verify:private": "node scripts/private-contract.mjs",
    "local:accounts": "node scripts/local-accounts.mjs",
    "test:competitive": "node tests/integration/competitive.test.mjs",
