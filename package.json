    "local:admin": "node scripts/local-admin.mjs",
    "test:competitive:browser": "node tooling/node_modules/@playwright/test/cli.js test --config phase3c.playwright.config.mjs",
    "local:rollback:competitive": "node scripts/rollback-competitive.mjs",
    "test:guandan:integration": "node tests/integration/guandan-standard.test.mjs",
    "test:guandan:browser": "node tooling/node_modules/@playwright/test/cli.js test --config phase3d.playwright.config.mjs"
