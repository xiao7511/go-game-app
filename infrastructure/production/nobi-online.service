[Unit]
Description=Nobi online game authority
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobi-online
Group=nobi-online
WorkingDirectory=/opt/nobi-online/current
EnvironmentFile=/etc/nobi-online.env
ExecStart=/opt/nobi-online/runtime/bin/node server/production.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nobi-online

[Install]
WantedBy=multi-user.target
